# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=generá-una-clave-segura-aqui
DEBUG=0

# ── Base de datos ────────────────────────────────────────────────────────────
DB_NAME=nombre_base_de_datos
DB_USER=usuario
DB_PASSWORD=contraseña
DB_HOST=host
DB_PORT=3306

# ── CORS y hosts ─────────────────────────────────────────────────────────────
ALLOWED_HOSTS=tudominio.com.ar,www.tudominio.com.ar
CORS_ALLOWED_ORIGINS=https://tudominio.com.ar

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=https://tudominio.com.ar

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Cliente ──────────────────────────────────────────────────────────────────
# Nombre que aparece en emails de recuperación de contraseña
NOMBRE_CLIENTE=Nombre del Cliente
# Remitente de emails: "Nombre <noreply@tudominio.com>"
EMAIL_FROM=noreply@tudominio.com

# ── Parámetros ERP (tabla `parametros`, aplica='Web') ────────────────────────
# Estos valores se configuran directamente en la BD — no son variables de entorno.
# Insertar en la tabla `parametros` antes del primer deploy:
#
#   codigo=1  nombre='punto_venta'     valor='9'   → número de punto de venta para pedidos web
#   codigo=2  nombre='nro_emp'         valor='3'   → número de empresa del ERP
#   codigo=3  nombre='monto_minimo'    valor='0'   → monto mínimo de pedido (0 = sin mínimo)
#   codigo=4  nombre='nrolis_defecto'  valor='0'   → lista de precios para nuevos clientes (0=base, 1=lista1)
