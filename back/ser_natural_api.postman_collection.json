{
  "info": {
    "name": "Ser Natural — API",
    "description": "Colección completa de endpoints de la API REST de Ser Natural.\n\n**Cómo usar:**\n1. Ejecutar la request «Login» — guarda automáticamente los tokens en las variables de colección `access_token` y `refresh_token`.\n2. Todas las requests con autenticación usan `{{access_token}}` en el header `Authorization: Bearer`.\n3. Cambiar `base_url` si el backend corre en otro host/puerto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",       "value": "http://localhost:8004", "type": "string" },
    { "key": "access_token",   "value": "",                      "type": "string" },
    { "key": "refresh_token",  "value": "",                      "type": "string" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [

        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access) {",
                  "    pm.collectionVariables.set('access_token',  json.access);",
                  "    pm.collectionVariables.set('refresh_token', json.refresh);",
                  "    pm.test('Tokens guardados', () => pm.response.to.have.status(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vendedor@ejemplo.com\",\n  \"clave\": \"mi_clave\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api","auth","login",""] }
          },
          "response": [
            {
              "name": "200 OK — Login exitoso",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"refresh\": \"<refresh_token>\",\n  \"access\": \"<access_token>\",\n  \"user\": {\n    \"codigo\": 1,\n    \"nombre\": \"Vendedor Ejemplo\",\n    \"email\": \"vendedor@ejemplo.com\",\n    \"catusu\": \"V\",\n    \"domcal\": \"Av. Alem\",\n    \"domnro\": \"1234\",\n    \"cuit\": \"20-12345678-9\",\n    \"dni\": \"12345678\",\n    \"catIva\": \"Responsable Inscripto\"\n  }\n}"
            },
            {
              "name": "401 — Credenciales inválidas",
              "status": "Unauthorized",
              "code": 401,
              "body": "{ \"error\": \"Credenciales inválidas\" }"
            },
            {
              "name": "400 — Faltan campos",
              "status": "Bad Request",
              "code": 400,
              "body": "{ \"error\": \"Debe proporcionar email y contraseña\" }"
            }
          ]
        },

        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access) {",
                  "    pm.collectionVariables.set('access_token', json.access);",
                  "    pm.test('Nuevo access_token guardado', () => pm.response.to.have.status(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/token/refresh/", "host": ["{{base_url}}"], "path": ["api","auth","token","refresh",""] }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{ \"access\": \"<nuevo_access_token>\" }"
            }
          ]
        },

        {
          "name": "Me (usuario autenticado)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/auth/me/", "host": ["{{base_url}}"], "path": ["api","auth","me",""] }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"codigo\": 1,\n  \"nombre\": \"Vendedor Ejemplo\",\n  \"email\": \"vendedor@ejemplo.com\",\n  \"catusu\": \"V\",\n  \"domcal\": \"Av. Alem\",\n  \"domnro\": \"1234\",\n  \"cuit\": \"20-12345678-9\",\n  \"dni\": \"12345678\",\n  \"catIva\": \"Responsable Inscripto\"\n}"
            },
            {
              "name": "401 — Sin token",
              "status": "Unauthorized",
              "code": 401,
              "body": "{ \"detail\": \"Authentication credentials were not provided.\" }"
            }
          ]
        }

      ]
    },

