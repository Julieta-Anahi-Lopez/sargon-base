    {
      "name": "Pedidos",
      "item": [

        {
          "name": "Pedidos — listar",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/pedidos/", "host": ["{{base_url}}"], "path": ["api","pedidos",""] }
          }
        },

        {
          "name": "Pedidos — detalle",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/pedidos/0009-00000001/", "host": ["{{base_url}}"], "path": ["api","pedidos","0009-00000001",""] },
            "description": "El id es el número de comprobante, formato `PPPP-NNNNNNNN`."
          }
        },

        {
          "name": "Crear pedido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"observ\": \"Entregar en turno mañana\",\n  \"detalle\": [\n    {\n      \"codigo\":      \"ART001\",\n      \"cantidad\":    3,\n      \"precio\":      150.50,\n      \"descuento\":   0,\n      \"observacion\": \"\"\n    },\n    {\n      \"codigo\":      \"ART002\",\n      \"cantidad\":    1,\n      \"precio\":      280.00,\n      \"descuento\":   5\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/pedidos/", "host": ["{{base_url}}"], "path": ["api","pedidos",""] },
            "description": "**Campos del pedido:**\n- `observ` (opcional): observaciones generales\n- `detalle` (requerido, al menos 1 ítem):\n  - `codigo` (string, requerido): código del artículo\n  - `cantidad` (float, requerido, > 0)\n  - `precio` (float, requerido, >= 0)\n  - `descuento` (float, opcional, default 0): porcentaje\n  - `observacion` (string, opcional)\n\n**Errores posibles:**\n- `400 stock_insuficiente`: devuelve `tipo`, `mensaje` e `items` con stock disponible vs solicitado. El frontend NO debe limpiar el carrito en este caso."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"compro\": \"0009-00000001\",\n  \"nrocli\": 42,\n  \"fecped\": \"2026-04-22T10:30:00\",\n  \"observ\": \"Entregar en turno mañana\",\n  \"nroven\": 1,\n  \"detalles\": [\n    {\n      \"compro\": \"0009-00000001\",\n      \"nroord\": 1,\n      \"codart\": \"ART001\",\n      \"cantid\": 3.0,\n      \"descri\": \"Arroz integral x 1kg\",\n      \"precio\": 150.50,\n      \"pordes\": 0.0\n    }\n  ]\n}"
            },
            {
              "name": "400 — Stock insuficiente",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"tipo\": \"stock_insuficiente\",\n  \"mensaje\": \"Algunos artículos no tienen stock suficiente para completar el pedido.\",\n  \"items\": [\n    { \"codigo\": \"ART001\", \"solicitado\": 10, \"disponible\": 3 }\n  ]\n}"
            },
            {
              "name": "400 — Artículo inexistente",
              "status": "Bad Request",
              "code": 400,
              "body": "{ \"detalle\": [{ \"codigo\": [\"El artículo con código XYZ no existe\"] }] }"
            }
          ]
        },

        {
          "name": "Crear pedido — mínimo (sin observaciones)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"detalle\": [\n    {\n      \"codigo\":   \"ART001\",\n      \"cantidad\": 1,\n      \"precio\":   150.50\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/pedidos/", "host": ["{{base_url}}"], "path": ["api","pedidos",""] }
          }
        }

      ]
    },

    {
      "name": "Errores de autenticación (referencia)",
      "item": [

        {
          "name": "Sin token — debe devolver 401",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/auth/me/", "host": ["{{base_url}}"], "path": ["api","auth","me",""] },
            "description": "Request sin header Authorization. Verifica que el endpoint rechaza correctamente."
          }
        },

        {
          "name": "Token inválido — debe devolver 401",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer token_invalido_aqui" }],
