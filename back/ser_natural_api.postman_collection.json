        {
          "name": "Crear usuario (solo vendedores)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\":   \"Juan García\",\n  \"e_mail\":   \"juan@ejemplo.com\",\n  \"nrodoc\":   \"30123456\",\n  \"clave\":    \"mi123\",\n  \"locali\":   8000,\n  \"cativa\":   \"CF\",\n  \"telcel\":   \"2914000000\",\n  \"domcalle\": \"Av. Alem 1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/web-usuarios/", "host": ["{{base_url}}"], "path": ["api","web-usuarios",""] },
            "description": "Requiere `catusu=V` en el token. Crea primero un Contacto y luego el WebUsuario.\n\n**Campos requeridos:** nombre, e_mail, nrodoc, locali, cativa\n**Campos opcionales:** clave (default: '1234'), telcel, domcalle, cuit (obligatorio si cativa != 'CF')\n\n**Localidades válidas:** 8000 (Bahía Blanca), 8103 (Ing. White), 8105 (Gral. Cerri), 8109 (Punta Alta), 8118 (Cabildo), 8150 (Cnel. Dorrego), 8153 (Monte Hermoso), 8160 (Tornquist), 8168 (Sierra de la Ventana), 8170 (Pigüé), 7530 (Cnel. Pringles)\n\n**Categorías IVA:** CF, 1 (Resp. Inscripto), 7 (Monotributista)"
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"codigo\": 42,\n  \"nombre\": \"Juan García\",\n  \"e_mail\": \"juan@ejemplo.com\",\n  \"catusu\": \"C\",\n  \"gposeg\": 0,\n  \"telcel\": \"2914000000\",\n  \"nrodoc\": \"30123456\"\n}"
            },
            {
              "name": "400 — DNI duplicado",
              "status": "Bad Request",
              "code": 400,
              "body": "{ \"error\": \"Ya existe un usuario web con este DNI\" }"
            },
            {
              "name": "400 — Email duplicado",
              "status": "Bad Request",
              "code": 400,
              "body": "{ \"error\": \"Ya existe un usuario web con este email\" }"
            },
            {
              "name": "401 — Sin autenticación",
              "status": "Unauthorized",
              "code": 401,
              "body": "{ \"detail\": \"Authentication credentials were not provided.\" }"
            },
            {
              "name": "403 — No es vendedor",
              "status": "Forbidden",
              "code": 403,
              "body": "{ \"detail\": \"You do not have permission to perform this action.\" }"
            }
          ]
        },

        {
          "name": "Crear usuario con CUIT (Resp. Inscripto)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\":   \"María López\",\n  \"e_mail\":   \"maria@ejemplo.com\",\n  \"nrodoc\":   \"25678901\",\n  \"clave\":    \"clave123\",\n  \"locali\":   8000,\n  \"cativa\":   \"1\",\n  \"cuit\":     \"27-25678901-3\",\n  \"telcel\":   \"2914111222\",\n  \"domcalle\": \"Belgrano 500\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/web-usuarios/", "host": ["{{base_url}}"], "path": ["api","web-usuarios",""] }
          }
        },

        {
